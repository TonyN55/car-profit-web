  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="CarProfit — Trang chủ"><img src="/images/carprofit-app-icon.png" alt="" width="42" height="42" /><span>CarProfit</span></a>
        <nav aria-label="Điều hướng chính"><a href="/#features">Tính năng</a><a href="/#screens">Giao diện</a><a href="/support/">Hỗ trợ</a></nav>
