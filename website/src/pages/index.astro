---
import "../styles/global.css";
import { appStoreUrl, googlePlayUrl } from "../data/store-links";

const features = [
  { number: "01", icon: "car", title: "Quản lý nhiều xe", description: "Lưu thông tin từng xe và chuyển đổi giữa các xe để theo dõi dữ liệu riêng biệt." },
  { number: "02", icon: "home", title: "Tổng quan hoạt động", description: "Theo dõi doanh thu, chi phí, số chuyến và các chỉ số trong ngày trên một màn hình." },
  { number: "03", icon: "route", title: "Quản lý cuốc xe", description: "Ghi nhận chuyến đi, doanh thu và xem lại lịch sử theo ngày, tuần hoặc tháng." },
  { number: "04", icon: "wallet", title: "Theo dõi thu chi", description: "Ghi lại các khoản thu và chi phí vận hành như nhiên liệu, sạc, bảo dưỡng và cầu đường." },
  { number: "05", icon: "chart", title: "Phân tích hiệu quả", description: "Theo dõi doanh thu, lợi nhuận vận hành và dòng tiền theo từng khoảng thời gian." },
  { number: "06", icon: "target", title: "Theo dõi thu hồi vốn", description: "Ghi nhận vốn đầu tư ban đầu và quan sát tiến độ thu hồi vốn từ hoạt động của xe." },
];

const previews = [
  { number: "01", name: "Quản lý xe", title: "Tất cả xe trong tầm kiểm soát.", description: "Quản lý danh sách phương tiện và chọn chiếc xe bạn muốn theo dõi.", image: "/images/screens/vehicle-management.png", alt: "Ảnh giao diện chức năng quản lý xe CarProfit", label: "DANH SÁCH XE" },
  { number: "02", name: "Tổng quan", title: "Nắm tình hình xe trong nháy mắt.", description: "Tổng quan doanh thu, chi phí, hoạt động và tiến độ tài chính.", image: "/images/screens/home-dashboard.png", alt: "Ảnh giao diện trang chủ CarProfit", label: "TRANG CHỦ" },
  { number: "03", name: "Thêm cuốc xe", title: "Ghi nhận chuyến đi nhanh chóng.", description: "Nhập thông tin chuyến và doanh thu ngay khi hoàn thành.", image: "/images/screens/add-trip.png", alt: "Ảnh giao diện thêm cuốc xe CarProfit", label: "THÊM CUỐC XE" },
  { number: "04", name: "Cuốc xe", title: "Theo dõi từng chuyến đi.", description: "Xem lại lịch sử chuyến và doanh thu theo khoảng thời gian.", image: "/images/screens/trip-history.png", alt: "Ảnh giao diện danh sách cuốc xe CarProfit", label: "LỊCH SỬ CUỐC XE" },
  { number: "05", name: "Thu chi", title: "Rõ ràng từng khoản thu và chi.", description: "Phân loại chi phí vận hành và theo dõi các khoản phát sinh.", image: "/images/screens/vehicle-finances.png", alt: "Ảnh giao diện quản lý thu chi CarProfit", label: "SỔ THU CHI" },
  { number: "06", name: "Phân tích", title: "Nhìn rõ hiệu quả hoạt động.", description: "Theo dõi xu hướng doanh thu, chi phí và kết quả theo thời gian.", image: "/images/screens/performance-analytics.png", alt: "Ảnh giao diện phân tích hiệu suất CarProfit", label: "BÁO CÁO HIỆU QUẢ" },
];

---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1730" />
    <meta name="description" content="CarProfit giúp bạn quản lý xe, cuốc xe, doanh thu, chi phí và theo dõi hiệu quả tài chính của từng chiếc xe." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="CarProfit" />
    <meta property="og:title" content="CarProfit — Quản lý tài chính xe" />
    <meta property="og:description" content="Quản lý xe, cuốc xe, thu chi và theo dõi hiệu quả tài chính trên iOS và Android." />
    <title>CarProfit — Quản lý tài chính xe</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/images/carprofit-app-icon.png" />
    <link rel="apple-touch-icon" href="/images/carprofit-app-icon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#top" aria-label="CarProfit — Trang chủ">
          <img src="/images/carprofit-app-icon.png" alt="" width="42" height="42" />
          <span>CarProfit</span>
        </a>
        <nav aria-label="Điều hướng chính">
          <a href="#features">Tính năng</a>
          <a href="#screens">Giao diện</a>
        </nav>
        <button class="header-download" type="button" data-open-store-picker>Tải ứng dụng <span aria-hidden="true">↓</span></button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">CARPROFIT · QUẢN LÝ TÀI CHÍNH XE</p>
            <h1>Hiểu rõ chiếc xe.<br /><span>Chủ động hiệu quả.</span></h1>
            <p class="hero-description">CarProfit giúp bạn quản lý xe, ghi nhận cuốc xe, theo dõi doanh thu và chi phí — để nắm rõ hơn hiệu quả hoạt động của từng chiếc xe.</p>
            <a class="primary-link" href="#features">Khám phá tính năng <span aria-hidden="true">→</span></a>
            <div class="platform-note">Ứng dụng dành cho iOS và Android</div>
          </div>
          <div class="hero-app">
            <div class="app-icon-wrap">
              <img src="/images/carprofit-app-icon.png" alt="Biểu tượng ứng dụng CarProfit" width="190" height="190" fetchpriority="high" />
            </div>
            <div class="app-name">CarProfit</div>
            <div class="app-category">QUẢN LÝ TÀI CHÍNH PHƯƠNG TIỆN</div>
            <div class="platform-pills" aria-label="Nền tảng hỗ trợ">
              <img src="/images/app-store.svg" alt="Tải ứng dụng trên App Store" width="128" height="42" />
              <img src="/images/google-play.svg" alt="Tải ứng dụng trên Google Play" width="138" height="42" />
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="features section-wrap">
        <div class="section-heading">
          <p class="eyebrow">CARPROFIT CÓ GÌ?</p>
          <h2>Mọi thông tin về chiếc xe<br /><span>trong một ứng dụng.</span></h2>
          <p>Những công cụ cần thiết để ghi nhận hoạt động và theo dõi bức tranh tài chính của xe.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => (
            <a class="feature-card" href="#screens">
              <div class="feature-card-top">
                <span class="feature-number">{feature.number}</span>
                <span class="feature-icon" aria-hidden="true">
                  {feature.icon === "car" && <svg viewBox="0 0 24 24"><path d="m4 11 1.7-4.2A2 2 0 0 1 7.6 5.5h8.8a2 2 0 0 1 1.9 1.3L20 11M3.5 11h17v7h-17zM6.5 18v1.5m11-1.5v1.5M7 14.5h.01M17 14.5h.01" /></svg>}
                  {feature.icon === "home" && <svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z" /></svg>}
                  {feature.icon === "route" && <svg viewBox="0 0 24 24"><circle cx="6" cy="18" r="2.5" /><circle cx="18" cy="6" r="2.5" /><path d="M8.5 18h2a3 3 0 0 0 3-3v-3a3 3 0 0 1 3-3h1" /></svg>}
                  {feature.icon === "wallet" && <svg viewBox="0 0 24 24"><path d="M4 7.5h15a2 2 0 0 1 2 2V19H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h13v3.5M2 8h16M16 13h5" /><circle cx="16" cy="13" r=".7" /></svg>}
                  {feature.icon === "chart" && <svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 14l4-4 3 2 6-7M15 5h5v5" /></svg>}
                  {feature.icon === "target" && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" /></svg>}
                </span>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
              <span class="feature-more">Xem giao diện <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>

      <section id="screens" class="screens-section" aria-labelledby="screens-title">
        <div class="section-wrap">
          <div class="section-heading screens-heading">
            <p class="eyebrow">KHÁM PHÁ ỨNG DỤNG</p>
            <h2 id="screens-title">Mỗi chức năng,<br /><span>một góc nhìn rõ ràng.</span></h2>
            <p>Ảnh chụp giao diện các chức năng chính của CarProfit.</p>
          </div>
          <div class="screens-grid">
            {previews.map((preview) => (
              <article class="screen-card">
                <div class="screen-copy">
                  <span class="screen-label">{preview.number} · {preview.label}</span>
                  <h3>{preview.title}</h3>
                  <p>{preview.description}</p>
                </div>
                <div class="screen-device screen-device-image">
                  <a href={preview.image} target="_blank" rel="noopener noreferrer" aria-label={"Mở ảnh " + preview.name + " kích thước đầy đủ"}>
                    <img src={preview.image} alt={preview.alt} loading="lazy" />
                  </a>
                </div>
              </article>
            ))}
          </div>
          <p class="screens-disclaimer">Hình ảnh giao diện được lấy từ thư mục screenshot của dự án CarProfit. Một số chức năng hoặc chỉ số có thể thay đổi theo phiên bản ứng dụng.</p>
        </div>
      </section>

      <section class="summary">
        <div class="section-wrap summary-inner">
          <div>
            <p class="eyebrow">CHIẾC XE CỦA BẠN · SỐ LIỆU CỦA BẠN</p>
            <h2>Từ từng cuốc xe<br />đến toàn cảnh tài chính.</h2>
          </div>
          <p>Tập hợp doanh thu, chi phí vận hành và dòng tiền để bạn có cái nhìn rõ ràng hơn về hoạt động và tiến độ thu hồi vốn của chiếc xe.</p>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <a class="brand" href="#top"><img src="/images/carprofit-app-icon.png" alt="" width="34" height="34" loading="lazy" /><span>CarProfit</span></a>
        <p>Quản lý tài chính xe, rõ từng khoản thu chi.</p>
        <nav class="footer-links" aria-label="Liên kết pháp lý và hỗ trợ"><a href="/terms/">Điều khoản sử dụng</a><a href="/privacy/">Quyền riêng tư</a><a href="/support/">Hỗ trợ</a></nav>
        <span>© {new Date().getFullYear()} CarProfit</span>
      </div>
    </footer>

    <dialog class="store-picker" id="store-picker" aria-labelledby="store-picker-title">
      <div class="store-picker-panel">
        <button class="store-picker-close" type="button" data-close-store-picker aria-label="Đóng">×</button>
        <p class="eyebrow">CARPROFIT · TẢI ỨNG DỤNG</p>
        <h2 id="store-picker-title">Bạn đang sử dụng nền tảng nào?</h2>
        <p class="store-picker-description">Chọn cửa hàng phù hợp để tải CarProfit về thiết bị của bạn.</p>
        <div class="store-picker-options">
          {appStoreUrl ? (
            <a class="store-picker-option" href={appStoreUrl} target="_blank" rel="noopener noreferrer" aria-label="Tải CarProfit trên App Store">
              <img src="/images/app-store.svg" alt="App Store" width="128" height="42" />
            </a>
          ) : (
            <div class="store-picker-option store-picker-unavailable" aria-disabled="true">
              <img src="/images/app-store.svg" alt="App Store" width="128" height="42" />
              <span>Sắp ra mắt</span>
            </div>
          )}
          {googlePlayUrl ? (
            <a class="store-picker-option" href={googlePlayUrl} target="_blank" rel="noopener noreferrer" aria-label="Tải CarProfit trên Google Play">
              <img src="/images/google-play.svg" alt="Google Play" width="138" height="42" />
            </a>
          ) : (
            <div class="store-picker-option store-picker-unavailable" aria-disabled="true">
              <img src="/images/google-play.svg" alt="Google Play" width="138" height="42" />
              <span>Sắp ra mắt</span>
            </div>
          )}
        </div>
      </div>
    </dialog>

    <script>
      const storePicker = document.querySelector<HTMLDialogElement>("#store-picker");
      document.querySelectorAll<HTMLButtonElement>("[data-open-store-picker]").forEach((button) => {
        button.addEventListener("click", () => storePicker?.showModal());
      });
      document.querySelectorAll<HTMLButtonElement>("[data-close-store-picker]").forEach((button) => {
        button.addEventListener("click", () => storePicker?.close());
      });
      storePicker?.addEventListener("click", (event) => {
        if (event.target === storePicker) storePicker?.close();
      });
    </script>
  </body>
</html>
